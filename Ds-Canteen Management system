/* SHOW PENDING QUEUE */  
void showQueue()  
{  
    QueueNode *temp;  

    clrscr();  

    cout << "====================================\n";  
    cout << "          PENDING ORDERS\n";  
    cout << "====================================\n";  

    temp = front;  

    if(temp == NULL)  
    {  
        cout << "\nQueue is empty.";  

        getch();  
        return;  
    }  

    cout << "\nFRONT\n";  

    while(temp != NULL)  
    {  
        cout << "\nOrder "  
             << temp->orderId  
             << " - "  
             << temp->customer  
             << " - "  
             << temp->food;  

        temp = temp->next;  
    }  

    cout << "\n\nREAR";  

    getch();  
}  

/* SHOW COMPLETED ORDER HISTORY */  
void showHistory()  
{  
    StackNode *temp;  

    clrscr();  

    cout << "====================================\n";  
    cout << "         COMPLETED ORDERS\n";  
    cout << "====================================\n";  

    temp = top;  

    if(temp == NULL)  
    {  
        cout << "\nNo order history available.";  

        getch();  
        return;  
    }  

    cout << "\nTOP\n";  

    while(temp != NULL)  
    {  
        cout << "\nOrder "  
             << temp->orderId  
             << " - "  
             << temp->customer  
             << " - "  
             << temp->food;  

        cout << "\nAmount : Rs. "  
             << temp->amount;  

        cout << "\n-----------------------------";  

        temp = temp->next;  
    }  

    getch();  
}  

/* STATISTICS */  
void statistics()  
{  
    int pending = 0;  
    int completed = 0;  
    int totalOrders = 0;  

    QueueNode *queueTemp;  
    StackNode *stackTemp;  

    clrscr();  

    queueTemp = front;  

    while(queueTemp != NULL)  
    {  
        pending++;  

        queueTemp = queueTemp->next;  
    }  

    stackTemp = top;  

    while(stackTemp != NULL)  
    {  
        completed++;  

        stackTemp = stackTemp->next;  
    }  

    totalOrders = pending + completed;  

    cout << "====================================\n";  
    cout << "          CANTEEN STATISTICS\n";  
    cout << "====================================\n";  

    cout << "\nTotal Orders     : "  
         << totalOrders;  

    cout << "\nPending Orders   : "  
         << pending;  

    cout << "\nCompleted Orders : "  
         << completed;  

    cout << "\nFood Items       : "  
         << foodCount;  

    getch();  
}  

